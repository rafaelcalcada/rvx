// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
  "name": "RVX (Ubuntu 24.04)",
  "image": "rafaelcalcada/rvx:latest",
  "runArgs": [
    "--hostname",
    "devcontainer"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        // Editor settings
        "editor.tabSize": 2,
        "editor.detectIndentation": false,
        "editor.formatOnSave": true,
        // Verilog settings
        "verilog.ctags.path": "/usr/local/bin/ctags",
        "verilog.linting.linter": "verilator",
        "verilog.linting.verilator.includePath": [
          "/workspaces/rvx/rtl/",
          "/workspaces/rvx/rtl/core/",
          "/workspaces/rvx/rtl/peripherals/",
          "/workspaces/rvx/rtl/memory/",
          "/workspaces/rvx/rtl/interconnect/",
          "/workspaces/rvx/tb/"
        ],
        "verilog.linting.verilator.arguments": "-Wall --timing",
        "verilog.formatting.verilogHDL.formatter": "verible-verilog-format",
        "verilog.formatting.veribleVerilogFormatter.arguments": "--flagfile=.devcontainer/.verible-format",
        // C/C++ settings
        "C_Cpp.clang_format_style": "file:/workspaces/rvx/.devcontainer/.clang-format",
        "C_Cpp.default.compilerPath": "/usr/local/bin/riscv32-unknown-elf-gcc",
        // CMake settings
        "cmake.configureOnOpen": false,
        "cmake.ignoreCMakeListsMissing": true,
        "cmake.sourceDirectory": "",
        "cmake.automaticReconfigure": false,
        "cmake.enableAutomaticKitScan": false
      },
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "cschlosser.doxdocgen",
        "eamodio.gitlens",
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.vscode-pylance",
        "daohong-emilio.yash",
        "enkia.tokyo-night",
        "ms-dotnettools.vscode-dotnet-runtime",
        "ms-azuretools.vscode-docker",
        "mshr-h.veriloghdl",
        "zhwu95.riscv",
        "lramseyer.vaporview"
      ]
    }
  },
  "remoteUser": "rvx"
}